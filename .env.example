# Default: models run through the local Claude Code CLI on its subscription login.
# Nothing is required here if `claude auth status` shows loggedIn: true.

# PHHC_BACKEND=claude_cli
# PHHC_CLAUDE_BIN=claude              # full path if not on PATH, e.g. /Users/you/.local/bin/claude
# PHHC_CLI_TIMEOUT_S=1200
# PHHC_REASONER_MODEL=claude-opus-5-5
# PHHC_REASONER_EFFORT=medium
# PHHC_READER_HAIKU=claude-haiku-4-5
# PHHC_READER_SONNET=claude-sonnet-5
# PHHC_DEFAULT_READER=haiku
# PHHC_READER_CHUNK_PAGES=20
# PHHC_READER_CONCURRENCY=2
# PHHC_DATA_DIR=./data
# PHHC_MAX_UPLOAD_MB=80

# Only when using the API instead of the subscription:
# PHHC_BACKEND=api
# ANTHROPIC_API_KEY=sk-ant-...
